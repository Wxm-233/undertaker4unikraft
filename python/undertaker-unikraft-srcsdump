#!/usr/bin/env python3
"""
Extract source file -> CONFIG condition mappings from Unikraft Makefile.uk files.

This complements undertaker-unikraft-kconfigdump by extracting the missing FILE_* 
preconditions that minigolem fails to generate.

Usage:
    undertaker-unikraft-srcsdump <root_dir> <output_rsf>
"""

import sys
import os
import re
from collections import defaultdict


SOURCE_EXTENSIONS = (
    '.c',
    '.cpp',
    '.cc',
    '.cxx',
    '.h',
    '.ld',
    '.S',
)


def normalize_file_symbol(path):
    """Match CppFile::getFileVar() normalization in ConditionalBlock.cpp."""
    return path.replace('\\', '/').translate(str.maketrans({
        '/': '_',
        '-': '_',
        '+': '_',
        ':': '_',
        ',': '_',
    }))


def strip_comment(line):
    return line.split('#', 1)[0]


def join_make_lines(content):
    lines = []
    buf = ''
    for raw in content.splitlines():
        line = strip_comment(raw).rstrip()
        if not line and not buf:
            continue
        if line.endswith('\\'):
            buf += line[:-1] + ' '
            continue
        lines.append((buf + line).strip())
        buf = ''
    if buf:
        lines.append(buf.strip())
    return lines


def normalize_config_condition(condition):
    if not condition or condition == 'y':
        return None
    if condition == 'm':
        return 'CONFIG_MODULES'
    match = re.search(r'CONFIG_\w+', condition)
    return match.group(0) if match else condition


def combine_conditions(*conditions):
    parts = []
    for cond in conditions:
        if not cond:
            continue
        if isinstance(cond, (list, tuple, set)):
            nested = combine_conditions(*cond)
            if nested:
                parts.append(nested)
        else:
            parts.append(str(cond))
    seen = []
    for part in parts:
        if part not in seen:
            seen.append(part)
    if not seen:
        return None
    if len(seen) == 1:
        return seen[0]
    return ' && '.join('(%s)' % item if ' || ' in item else item for item in seen)


def combine_alternatives(conditions):
    filtered = sorted(set(cond for cond in conditions if cond))
    if len(filtered) == 0:
        return None
    if len(filtered) == 1:
        return filtered[0]
    return ' || '.join('(%s)' % item for item in filtered)


def resolve_vars(value, variables):
    ret = value
    for _ in range(16):
        changed = False
        for match in re.finditer(r'\$[\(\{]([A-Za-z0-9_]+)[\)\}]', ret):
            var = match.group(1)
            if var not in variables:
                continue
            ret = ret.replace(match.group(0), variables[var])
            changed = True
        if not changed:
            break
    return ret


def relpath_from_root(path, root_dir, current_dir):
    path = path.replace('\\', '/')
    if '|' in path:
        path = path.split('|', 1)[0]
    if '>' in path:
        return None
    if '$(' in path or '${' in path:
        return None
    if not path.endswith(SOURCE_EXTENSIONS):
        return None

    if os.path.isabs(path):
        abs_path = os.path.normpath(path)
    else:
        candidate = os.path.normpath(os.path.join(root_dir, path))
        if os.path.exists(candidate):
            abs_path = candidate
        else:
            abs_path = os.path.normpath(os.path.join(current_dir, path))

    if not os.path.exists(abs_path):
        return None

    rel = os.path.relpath(abs_path, root_dir)
    return rel.replace('\\', '/')


def lib_prefix_from_addlib(name):
    return name.upper()


def extract_lib_srcs(root_dir):
    """
    Scan Makefile.uk files and extract LIBXXX_SRCS-* patterns.
    
    Returns dict: {file_path: [condition_list]}
    where each condition is a tuple like ('y',) for unconditional or ('$(CONFIG_FOO)',) for conditional.
    """
    root_dir = os.path.abspath(root_dir)
    file_conditions = defaultdict(set)

    # Pattern: LIBXXX_SRCS-condition += files
    lib_srcs_pattern = re.compile(
        r'^\s*(\w+)_SRCS-([ym]|\$\(CONFIG_\w+\)|\$\{CONFIG_\w+\})\s*[:+]?=\s*(.+)$'
    )

    base_assign_pattern = re.compile(r'^\s*([A-Za-z0-9_]+_BASE)\s*[:?+]?=\s*(.+)$')
    addlib_s_pattern = re.compile(
        r'\$\(eval\s+\$\(call\s+(?:addlib_s|addplat_s)\s*,\s*([^,\s\)]+)\s*,\s*([^\)]+)\)\)'
    )

    # Walk all Makefile.uk files
    file_count = 0
    match_count = 0
    skipped_refs = 0
    for dirpath, dirnames, filenames in os.walk(root_dir):
        # Skip build and git directories
        dirnames[:] = [d for d in dirnames if d not in ['build', '.git', '__pycache__']]

        for filename in filenames:
            if filename in ['Makefile.uk', 'Makefile']:
                filepath = os.path.join(dirpath, filename)
                file_count += 1
                try:
                    with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                        content = f.read()
                except Exception as e:
                    print(f"Warning: Could not read {filepath}: {e}", file=sys.stderr)
                    continue

                lines = join_make_lines(content)
                current_dir = os.path.dirname(filepath)
                variables = {
                    'CONFIG_UK_BASE': root_dir,
                    'UK_BASE': root_dir,
                    'UK_APP': root_dir,
                    'UK_PLAT_COMMON_BASE': os.path.join(root_dir, 'plat', 'common'),
                }
                lib_conditions = {}

                for line in lines:
                    match = base_assign_pattern.match(line)
                    if match:
                        variables[match.group(1)] = resolve_vars(match.group(2).strip(), variables)

                    match = addlib_s_pattern.search(line)
                    if match:
                        lib_conditions[lib_prefix_from_addlib(match.group(1))] = \
                            normalize_config_condition(match.group(2))

                # Extract LIBXXX_SRCS-* assignments
                for line in lines:
                    match = lib_srcs_pattern.match(line)
                    if not match:
                        continue
                    match_count += 1
                    lib_prefix = match.group(1)  # e.g., LIBUKALLOC
                    condition_str = match.group(2)  # e.g., 'y' or '$(CONFIG_FOO)'
                    files_str = match.group(3)  # e.g., '$(LIBUKALLOC_BASE)/alloc.c'
                    variables.setdefault(lib_prefix + '_BASE', current_dir)

                    file_condition = normalize_config_condition(condition_str)
                    lib_condition = lib_conditions.get(lib_prefix)
                    condition = combine_conditions(lib_condition, file_condition)

                    # Parse file list (split on whitespace and handle $(VAR))
                    files = files_str.split()
                    for file_ref in files:
                        file_ref = file_ref.strip()
                        if not file_ref:
                            continue

                        # Expand $(VAR) references
                        resolved = resolve_vars(file_ref, variables)
                        rel_path = relpath_from_root(resolved, root_dir, current_dir)
                        if rel_path is None:
                            skipped_refs += 1
                            continue

                        file_symbol = normalize_file_symbol(rel_path)
                        if condition:
                            file_conditions[file_symbol].add(condition)
                        else:
                            file_conditions[file_symbol].add('')
    
    print(
        f"Debug: Scanned {file_count} Makefile* files, found {match_count} SRCS patterns, "
        f"skipped {skipped_refs} unresolved/generated refs",
        file=sys.stderr
    )

    return file_conditions


def main(argc, argv):
    if len(argv) < 3:
        print("Usage: {} <root_dir> <output_file>".format(argv[0]), file=sys.stderr)
        sys.exit(1)

    root_dir = argv[1]
    output_file = argv[2]

    if not os.path.isdir(root_dir):
        print("Error: {} is not a directory".format(root_dir), file=sys.stderr)
        sys.exit(1)

    # Extract source file conditions
    file_conditions = extract_lib_srcs(root_dir)

    # Write output in precondition format: FILE_path<tab>CONFIG_condition
    try:
        with open(output_file, 'w', encoding='utf-8') as f:
            for file_path in sorted(file_conditions.keys()):
                conditions = file_conditions[file_path]
                if '' in conditions:
                    # Unconditional file
                    f.write("FILE_{}\n".format(file_path))
                else:
                    condition = combine_alternatives(conditions)
                    if condition:
                        f.write('FILE_{} "{}"\n'.format(file_path, condition))
                    else:
                        f.write("FILE_{}\n".format(file_path))

        print("Extracted {} source files from {} into {}".format(
            len(file_conditions), root_dir, output_file), file=sys.stderr)
        sys.exit(0)

    except Exception as e:
        print("Error writing output: {}".format(e), file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main(len(sys.argv), sys.argv)
