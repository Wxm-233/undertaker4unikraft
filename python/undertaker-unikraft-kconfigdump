SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LEGACY_SCRIPT="$SCRIPT_DIR/undertaker-kconfigdump"

if [ ! -f Config.uk ] && [ ! -f Makefile.uk ]; then
    exec "$LEGACY_SCRIPT" "$@"
fi

MODELS=${MODELS:-models}
ARCH=${UK_ARCH:-x86_64}

usage() {
    echo "\`undertaker-unikraft-kconfigdump' generates baseline models for Unikraft"
    echo
    echo "Usage: ${0##*/} [-a ARCH] [-m DIR]"
    echo " -a <arch>      Architecture/model name (default: UK_ARCH or x86_64)"
    echo " -m <modeldir>  Directory where models are written (default: models)"
}

while getopts :a:m:h OPT; do
    case $OPT in
        a)
            ARCH="$OPTARG"
            ;;
        m)
            MODELS="$OPTARG"
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done
shift $(( OPTIND - 1 ))
OPTIND=1

mkdir -p "$MODELS"

MODEL_FILE="$MODELS/$ARCH.model"
RSF_FILE="$MODELS/$ARCH.rsf"
BASE_MODEL_FILE="$MODELS/$ARCH.model.base.tmp"
TMP_BODY="$MODELS/$ARCH.model.body.tmp"
TMP_MINIGOLEM="$MODELS/$ARCH.preconditions.tmp"
TMP_SRCSDUMP="$MODELS/$ARCH.preconditions.srcs.tmp"
TMP_MERGED="$MODELS/$ARCH.preconditions.merged.tmp"
TMP_FILES="$MODELS/$ARCH.model.files.tmp"
TMP_SYMBOLS="$MODELS/$ARCH.model.symbols.tmp"
TMP_MODEL_SYMBOLS="$MODELS/$ARCH.model.symbols.base.tmp"
TMP_EXTRA_SYMBOLS="$MODELS/$ARCH.model.symbols.extra.tmp"
TMP_BASE_CANDIDATE="$MODELS/$ARCH.model.base.candidate.tmp"

CCDB_FILE=""
for candidate in "build/compile_commands.json" "compile_commands.json"; do
    if [ -f "$candidate" ]; then
        CCDB_FILE="$candidate"
        break
    fi
done

ROOT_DIR=$(pwd -P)
RSF_DUMPER="$SCRIPT_DIR/undertaker-unikraft-rsfdump"
UK_RSF2MODEL="$SCRIPT_DIR/undertaker-unikraft-rsf2model"
RSF2MODEL=$(which rsf2model 2>/dev/null || true)
if [ -z "$RSF2MODEL" ] && [ -x "$SCRIPT_DIR/rsf2model" ]; then
    RSF2MODEL="$SCRIPT_DIR/rsf2model"
fi
MINIGOLEM=$(which minigolem 2>/dev/null || true)
if [ -z "$MINIGOLEM" ] && [ -x "$SCRIPT_DIR/minigolem" ]; then
    MINIGOLEM="$SCRIPT_DIR/minigolem"
fi

if [ ! -x "$RSF_DUMPER" ]; then
    RSF_DUMPER=$(which undertaker-unikraft-rsfdump || true)
fi

run_rsfdump() {
    if "$RSF_DUMPER" . "$RSF_FILE" >/dev/null 2>/dev/null; then
        return 0
    fi

    if which python3 >/dev/null 2>&1; then
        python3 "$RSF_DUMPER" . "$RSF_FILE" >/dev/null
        return $?
    fi

    return 1
}

if [ -x "$RSF_DUMPER" ]; then
    if ! run_rsfdump; then
        echo "Warning: RSF dumper failed, falling back to minimal RSF generation." >&2
    fi
fi

if [ ! -s "$RSF_FILE" ]; then
    # Fallback: minimal RSF from declared symbols only.
    find . -type f \( -name 'Config.uk' -o -name 'Kconfig*' \) \
        ! -path './build/*' ! -path './.git/*' ! -path './.git' -print0 | \
        xargs -0 grep -h -E '^[[:space:]]*(config|menuconfig)[[:space:]]+[A-Za-z0-9_]+' 2>/dev/null | \
        sed -E 's/^[[:space:]]*(config|menuconfig)[[:space:]]+([A-Za-z0-9_]+).*$/Item\t\2\tboolean/' | \
        sort -u > "$RSF_FILE"
fi

# Build symbol list from RSF item declarations.
awk '
/^Item[[:space:]]+/ {
    print "CONFIG_" $2;
    if ($3 == "tristate")
        print "CONFIG_" $2 "_MODULE";
}
' "$RSF_FILE" | sort -u > "$TMP_SYMBOLS"

# Build fallback FILE_* inferences from compile_commands if available.
: > "$TMP_FILES"
if [ -n "$CCDB_FILE" ]; then
    grep -E '"file"[[:space:]]*:' "$CCDB_FILE" | \
        sed -E 's/.*"file"[[:space:]]*:[[:space:]]*"([^\"]+)".*/\1/' | \
        while IFS= read -r path; do
            file_path=$(printf '%s' "$path" | sed 's#\\\\#/#g;s#\\#/#g')
            case "$file_path" in
                "$ROOT_DIR"/*)
                    rel_path=${file_path#"$ROOT_DIR"/}
                    ;;
                ./*)
                    rel_path=${file_path#./}
                    ;;
                *)
                    rel_path=$file_path
                    ;;
            esac
            norm_path=$(printf '%s' "$rel_path" | sed 's#^\./##;s#[-+:,/]#_#g')
            printf 'FILE_%s\n' "$norm_path"
        done | sort -u > "$TMP_FILES"
fi

: > "$TMP_MINIGOLEM"

# Generate a base model from RSF when possible.
write_fallback_model() {
    {
        echo "UNDERTAKER_SET SCHEMA_VERSION 1.1"
        echo "UNDERTAKER_SET ALWAYS_ON"
        cat "$TMP_SYMBOLS"
    } > "$BASE_MODEL_FILE"
}

if [ -f "$UK_RSF2MODEL" ] && command -v python3 >/dev/null 2>&1 \
        && python3 "$UK_RSF2MODEL" "$RSF_FILE" > "$TMP_BASE_CANDIDATE"; then
    mv "$TMP_BASE_CANDIDATE" "$BASE_MODEL_FILE"
elif [ -n "$RSF2MODEL" ]; then
    if command -v python2 >/dev/null 2>&1; then
        python2 "$RSF2MODEL" "$RSF_FILE" > "$TMP_BASE_CANDIDATE" 2>"$MODELS/$ARCH.rsf2model-errors" || true
    else
        "$RSF2MODEL" "$RSF_FILE" > "$TMP_BASE_CANDIDATE" 2>"$MODELS/$ARCH.rsf2model-errors" || true
    fi

    if [ -s "$TMP_BASE_CANDIDATE" ]; then
        mv "$TMP_BASE_CANDIDATE" "$BASE_MODEL_FILE"
        rm -f "$MODELS/$ARCH.rsf2model-errors"
    else
        echo "Warning: rsf2model failed or produced an empty model; falling back to declared-symbol model." >&2
        write_fallback_model
    fi
else
    write_fallback_model
fi
if ! grep -q '^UNDERTAKER_SET CONFIGURATION_SPACE_REGEX' "$BASE_MODEL_FILE"; then
    {
        echo "UNDERTAKER_SET CONFIGURATION_SPACE_REGEX \"CONFIG_.*\""
        cat "$BASE_MODEL_FILE"
    } > "$BASE_MODEL_FILE.withregex"
    mv "$BASE_MODEL_FILE.withregex" "$BASE_MODEL_FILE"
fi

# Create a provisional model for minigolem.
cp "$BASE_MODEL_FILE" "$MODEL_FILE"

# Try to enrich with parser-derived file preconditions.
if [ -n "$MINIGOLEM" ]; then
    if ! "$MINIGOLEM" -a "$ARCH" -m "$MODEL_FILE" 2>"$MODELS/$ARCH.minigolem-errors" | sort -u > "$TMP_MINIGOLEM"; then
        echo "Warning: minigolem precondition extraction failed for $ARCH; continuing with baseline model." >&2
    fi
fi

# Supplement with direct source file extraction from Makefile.uk.
: > "$TMP_SRCSDUMP"
SRCS_DUMPER="$SCRIPT_DIR/undertaker-unikraft-srcsdump"
if [ ! -x "$SRCS_DUMPER" ]; then
    SRCS_DUMPER=$(which undertaker-unikraft-srcsdump || true)
fi

if [ -f "$SRCS_DUMPER" ]; then
    if [ -x "$SRCS_DUMPER" ] && "$SRCS_DUMPER" . "$TMP_SRCSDUMP" 2>/dev/null; then
        :
    elif which python3 >/dev/null 2>&1; then
        python3 "$SRCS_DUMPER" . "$TMP_SRCSDUMP" 2>/dev/null || :
    fi
fi

# Merge file preconditions without letting fallback/unconditional sources erase
# more precise Makefile.uk conditions. RsfReader keeps the first occurrence of a
# key, so duplicate FILE_* rows must be removed before appending to the model.
: > "$TMP_BODY"
cat "$TMP_SRCSDUMP" > "$TMP_BODY"
awk '
    NR == FNR {
        if ($1 != "")
            seen[$1] = 1
        print
        next
    }
    !($1 in seen) {
        seen[$1] = 1
        print
    }
' "$TMP_BODY" "$TMP_MINIGOLEM" > "$TMP_MERGED"
mv "$TMP_MERGED" "$TMP_BODY"
awk '
    NR == FNR {
        if ($1 != "")
            seen[$1] = 1
        print
        next
    }
    !($1 in seen) {
        seen[$1] = 1
        print
    }
' "$TMP_BODY" "$TMP_FILES" > "$TMP_MERGED"
mv "$TMP_MERGED" "$TMP_BODY"
sort -u "$TMP_BODY" > "$TMP_BODY.sorted"

cp "$BASE_MODEL_FILE" "$MODEL_FILE"
cat "$TMP_BODY.sorted" >> "$MODEL_FILE"

rm -f "$TMP_BODY" "$TMP_BODY.sorted" "$TMP_MINIGOLEM" "$TMP_SRCSDUMP" "$TMP_MERGED" \
    "$TMP_FILES" "$TMP_SYMBOLS" "$BASE_MODEL_FILE" "$TMP_BASE_CANDIDATE"

echo "Generated baseline Unikraft model: $MODEL_FILE"
echo "Generated baseline Unikraft RSF: $RSF_FILE"
if [ -n "$CCDB_FILE" ]; then
    echo "Included FILE_ entries from: $CCDB_FILE"
fi
echo "Configuration source: RSF + compile_commands + Makefile.uk scans"
