set -e

MODE="scan-deads"
DEFAULT_ARCH="x86_64"
MODELS=${MODELS:-models}
PROCESSORS=${PROCESSORS:-$(getconf _NPROCESSORS_ONLN)}

find_undertaker_basepath() {
    if [ -n "$UNDERTAKER_BASE" ]; then
        echo "$UNDERTAKER_BASE"
        return 0
    fi

    local script_dir
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    local source_base
    source_base=$(readlink -f "$script_dir/..")

    local ud
    ud=$(which undertaker)
    if [ -z "$ud" ]; then
        echo "$source_base"
        return 0
    fi

    local undertaker_path
    undertaker_path=$(readlink -f "$ud")
    local b
    b=$(dirname "$undertaker_path")
    echo "${b}/.."
}

find_undertaker_cmd() {
    if which undertaker >/dev/null 2>&1; then
        echo "undertaker"
        return 0
    fi

    local base
    base=$(find_undertaker_basepath)
    local local_bin="$base/undertaker/undertaker"
    if [ -x "$local_bin" ]; then
        echo "$local_bin"
        return 0
    fi

    if [ -f "$base/Makefile" ] && which make >/dev/null 2>&1; then
        echo "No undertaker binary found, trying to build it from source at $base..." >&2
        local build_log
        build_log="$base/undertaker-unikraft-tree.build.log"
        if make -C "$base" undertaker/undertaker >"$build_log" 2>&1; then
            if [ -x "$local_bin" ]; then
                echo "$local_bin"
                return 0
            fi
        else
            echo "Auto-build failed, see $build_log" >&2
        fi
    fi

    return 1
}

usage() {
    echo "\`undertaker-unikraft-tree' drives undertaker over a whole Unikraft tree"
    echo
    echo "Usage: ${0##*/} [-m DIR] [-a ARCH] [-t PROCS] [-c|-s]"
    echo " -m <modeldir>  Specify the directory for the models"
    echo "           (default: models)"
    echo " -a <arch>  Default architecture to check for"
    echo "        (default: x86_64)"
    echo " -t <count>   Number of analyzing processes"
    echo "        (default: _NPROCESSORS_ONLN)"
    echo " -c  Do coverage analysis instead of dead block search"
    echo " -s  Do feature statistics instead of dead block search"
}

while getopts :t:m:a:csvh OPT; do
    case $OPT in
        m)
            MODELS="$OPTARG"
            ;;
        a)
            DEFAULT_ARCH="$OPTARG"
            ;;
        t)
            PROCESSORS="$OPTARG"
            ;;
        c)
            MODE="calc-coverage"
            ;;
        s)
            MODE="feature-statistics"
            ;;
        v)
            echo "undertaker-unikraft-tree"
            exit
            ;;
        h)
            usage
            exit
            ;;
    esac
done
shift $(( OPTIND - 1 ))
OPTIND=1

if [ ! -f Config.uk ] && [ ! -f Makefile.uk ]; then
    echo "Not run in a Unikraft tree. Please run inside a Unikraft tree without arguments"
    exit 1
fi

UNDERTAKER_CMD=$(find_undertaker_cmd || true)
if [ -z "$UNDERTAKER_CMD" ]; then
    echo "No undertaker binary found (PATH or source build output)."
    exit 1
fi

if ! ls "$MODELS"/*.model >/dev/null 2>&1 && ! ls "$MODELS"/*.cnf >/dev/null 2>&1; then
    echo "No models found in $MODELS, trying to generate baseline Unikraft models..."
    UK_DUMP="$(find_undertaker_basepath)/bin/undertaker-unikraft-kconfigdump"
    if [ ! -x "$UK_DUMP" ]; then
        UK_DUMP="$(find_undertaker_basepath)/python/undertaker-unikraft-kconfigdump"
    fi

    if [ ! -f "$UK_DUMP" ] && [ ! -x "$UK_DUMP" ]; then
        echo "Could not find undertaker-unikraft-kconfigdump (checked install and source paths)."
        exit 1
    fi

    if ! bash "$UK_DUMP" -a "$DEFAULT_ARCH" -m "$MODELS"; then
        echo "Automatic model generation failed."
        exit 1
    fi

    if ! ls "$MODELS"/*.model >/dev/null 2>&1 && ! ls "$MODELS"/*.cnf >/dev/null 2>&1; then
        echo "Model generation did not produce usable model files."
        exit 1
    fi
fi

make_worklist() {
    local output_file="$1"
    local include_headers="${2:-yes}"

    if [ "$include_headers" = "yes" ]; then
        find -type f \( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.S' -o -name '*.h' \) \
            ! -path './build/*' ! -path './.git/*' ! -path './.git' \
            -exec grep -q -E '^#[[:space:]]*if|^#[[:space:]]*else' {} \; -print | shuf > "$output_file"
        return
    fi

    local included_fragments
    included_fragments=$(mktemp "${TMPDIR:-/tmp}/undertaker-unikraft-includes.XXXXXX")
    find -type f \( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.S' -o -name '*.h' \) \
        ! -path './build/*' ! -path './.git/*' ! -path './.git' \
        -exec grep -h -E '^[[:space:]]*#[[:space:]]*include[[:space:]]*"[^"]+"' {} \; 2>/dev/null | \
        sed -E 's/.*"([^"]+)".*/\1/;s#^.*/##' | sort -u > "$included_fragments"

    find -type f \( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.S' \) \
        ! -path './build/*' ! -path './.git/*' ! -path './.git' ! -path './support/*' \
        -exec grep -q -E '^#[[:space:]]*if|^#[[:space:]]*else' {} \; -print | \
        awk -v included="$included_fragments" '
            BEGIN {
                while ((getline name < included) > 0)
                    skip[name] = 1
                close(included)
            }
            {
                base = $0
                sub(/^.*\//, "", base)
                if (!skip[base])
                    print
            }
        ' | shuf > "$output_file"
    rm -f "$included_fragments"
}

if [ "$MODE" = "calc-coverage" ]; then
    make_worklist undertaker-unikraft-coverage-worklist no

    files=$(wc -l < undertaker-unikraft-coverage-worklist)
    echo "Calculating partial configurations (greedy variant) on $files files"

    "$UNDERTAKER_CMD" -k -v -j coverage -C min -t "$PROCESSORS" \
        -b undertaker-unikraft-coverage-worklist \
        -m "$MODELS" -M "$DEFAULT_ARCH" 2>&1 | grep '^I: .*Found Solutions:' > coverage.txt

    if [ ! -s coverage.txt ]; then
        echo "Coverage analysis failed!"
        exit 1
    fi

    echo "TOP 50 variable files:"
    awk -F'I: ' '/^I: / { print $2 }' < coverage.txt |
            awk -F, '/Found Solutions/ { printf "%s %s\n", $2, $1 }' |
            sort -n -r | head -n 50 | tee coverage.stats
    exit 0
fi

if [ "$MODE" = "feature-statistics" ]; then
    make_worklist undertaker-unikraft-worklist "${UNDERTAKER_INCLUDE_HEADERS:-no}"

    "$UNDERTAKER_CMD" -k -j cppsym -b undertaker-unikraft-worklist -m "$MODELS" -M "$DEFAULT_ARCH" \
        2>undertaker-unikraft-cppsym.errors >undertaker-unikraft-all-cppsym.raw
    awk '
BEGIN { FS=", " }
{
    references[$1] = references[$1] + $2;
    rewrites[$1] = rewrites[$1] + $3;
}
END {
    for (item in references) {
        printf "%s, %d, %d\n", item, references[item], rewrites[item]
    }
}' < undertaker-unikraft-all-cppsym.raw > undertaker-unikraft-all-cppsym
    echo "Found $(wc -l < undertaker-unikraft-all-cppsym) distinct CPP symbols."
    exit 0
fi

make_worklist undertaker-unikraft-worklist "${UNDERTAKER_INCLUDE_HEADERS:-no}"

find . -type f -name '*dead' -delete

echo "Analyzing $(wc -l < undertaker-unikraft-worklist) files with $PROCESSORS threads."
"$UNDERTAKER_CMD" -k -t "$PROCESSORS" -b undertaker-unikraft-worklist -m "$MODELS" -M "$DEFAULT_ARCH"
printf "\n\nFound %s global defects\n" "$(find . -name '*dead' | grep globally | grep -v no_kconfig | wc -l)"
exit 0
